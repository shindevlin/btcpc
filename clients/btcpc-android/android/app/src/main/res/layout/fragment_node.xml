<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0a">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NODE"
            android:textColor="#f59e0b"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/node_account_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#6b7280"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="No wallet"
            android:layout_marginBottom="20dp" />

        <!-- ── Sensor availability ──────────────────────────────────────── -->

        <TextView android:text="SENSORS DETECTED" style="@style/FieldLabel" />
        <TextView
            android:id="@+id/sensor_list_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:textColor="#d1d5db"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="Scanning..."
            android:layout_marginBottom="16dp" />

        <!-- ── Coverage report (GPS + cell) ───────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COVERAGE REPORT"
            android:textColor="#f59e0b"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/coverage_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:textColor="#9ca3af"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="—"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_collect_coverage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Collect + Submit Coverage"
            android:backgroundTint="#f59e0b"
            android:textColor="#0a0a0a"
            android:layout_marginBottom="20dp" />

        <!-- ── Sensor batch (all sensors) ─────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SENSOR BATCH"
            android:textColor="#f59e0b"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/batch_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:textColor="#9ca3af"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="—"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btn_collect_batch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Collect"
                android:backgroundTint="#1f2937"
                android:textColor="#f59e0b"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_submit_batch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Submit Batch"
                android:backgroundTint="#1f2937"
                android:textColor="#9ca3af" />

        </LinearLayout>

        <!-- ── Flipper relay ───────────────────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FLIPPER RELAY"
            android:textColor="#f59e0b"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/flipper_buffer_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:textColor="#9ca3af"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="Waiting for Flipper frames..."
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_relay_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relay Flipper Data to Node"
            android:backgroundTint="#1f2937"
            android:textColor="#9ca3af"
            android:enabled="false"
            android:layout_marginBottom="20dp" />

        <!-- ── Capability announcement ─────────────────────────────────────── -->

        <Button
            android:id="@+id/btn_announce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Announce Capabilities to Network"
            android:backgroundTint="#1f2937"
            android:textColor="#f59e0b"
            android:layout_marginBottom="20dp" />

        <!-- ── Inference jobs ──────────────────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INFERENCE JOBS"
            android:textColor="#f59e0b"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_fetch_jobs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fetch Open Jobs"
            android:backgroundTint="#1f2937"
            android:textColor="#f59e0b"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/jobs_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- ── Log ────────────────────────────────────────────────────────── -->

        <TextView
            android:id="@+id/node_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:textColor="#6b7280"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="" />

    </LinearLayout>
</ScrollView>
