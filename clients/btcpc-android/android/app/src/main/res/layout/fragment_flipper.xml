<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0a">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FLIPPER"
            android:textColor="#f59e0b"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Scan / device list -->
        <LinearLayout
            android:id="@+id/scan_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan for Flipper"
                android:backgroundTint="#f59e0b"
                android:textColor="#0a0a0a"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/device_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Connected controls -->
        <LinearLayout
            android:id="@+id/connected_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView android:text="FLIPPER PUBKEY" style="@style/FieldLabel" />
            <TextView
                android:id="@+id/pubkey_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:textColor="#f59e0b"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp" />

            <TextView android:text="MESSAGE TO SIGN" style="@style/FieldLabel" />
            <EditText
                android:id="@+id/sign_input"
                style="@style/FieldInput"
                android:hint="hello btcpc"
                android:text="hello btcpc"
                android:inputType="text" />

            <Button
                android:id="@+id/btn_sign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sign with Flipper"
                android:backgroundTint="#f59e0b"
                android:textColor="#0a0a0a"
                android:layout_marginBottom="12dp" />

            <TextView android:text="SIGNATURE (64 bytes)" style="@style/FieldLabel" />
            <TextView
                android:id="@+id/sig_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:textColor="#d1d5db"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:text="—"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_disconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Disconnect"
                android:backgroundTint="#1f2937"
                android:textColor="#ef4444"
                android:layout_marginBottom="20dp" />

            <!-- Sensor data channel -->
            <TextView android:text="FLIPPER SENSORS" style="@style/FieldLabel" />

            <TextView
                android:id="@+id/flipper_sensor_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:textColor="#9ca3af"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:text="Waiting for sensor data..."
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_request_subghz"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Sub-GHz Scan"
                    android:backgroundTint="#1f2937"
                    android:textColor="#f59e0b"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_request_heartbeat"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Heartbeat"
                    android:backgroundTint="#1f2937"
                    android:textColor="#9ca3af" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_request_rfid"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="RFID Scan"
                    android:backgroundTint="#1f2937"
                    android:textColor="#f59e0b"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_request_nfc"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="NFC Scan"
                    android:backgroundTint="#1f2937"
                    android:textColor="#f59e0b" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_request_ibutton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="iButton"
                    android:backgroundTint="#1f2937"
                    android:textColor="#9ca3af"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_request_ir"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="IR Capture"
                    android:backgroundTint="#1f2937"
                    android:textColor="#9ca3af" />

            </LinearLayout>

        </LinearLayout>

        <TextView android:text="LOG" style="@style/FieldLabel" />
        <TextView
            android:id="@+id/log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:textColor="#6b7280"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="Ready." />

    </LinearLayout>
</ScrollView>
