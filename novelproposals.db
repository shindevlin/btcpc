[[proposal]]
id = "a3f8c1d2-7e4b-4a0f-8b6d-2c9e5f1a0d3b"
date_found = "2026-05-22"
title = "Bitcoin Mesh Relay (BMR)"
source_type = "github+blog+docs+synthesis"
source_url = "https://github.com/eddieoz/btcmesh"
repo_url = "https://github.com/eddieoz/btcmesh"
project_name = "Bitcoin Mesh Relay — synthesized protocol design"
maintainer = "Multiple (btcmesh: eddieoz; BTCtoolshed bridge; Bitchat: permissionlesstech; Blockstream Satellite: Blockstream)"
license = "MIT (btcmesh), GPL (BTCtoolshed), MIT (Bitchat)"
last_commit = "2025-07"
activity_level = "active"
tags = "bitcoin,lora,meshtastic,offline,relay,spv,satellite,nostr,i2p,tor,mesh,transport,gateway,hardware-clients,bip157,bip158,blockstream"
btcpc_area = "hardware clients / gateway / P2P protocol / deployment"
summary = "A layered relay protocol for routing signed Bitcoin transactions outbound over LoRa/Meshtastic mesh and receiving Bitcoin block headers inbound via Blockstream Satellite or Nostr — enabling Bitcoin use with zero internet access at the originating device. Existing BTCPC transport cascade (Nostr, I2P, Tor) can serve as the gateway exit layer with minimal additional work. BIP158 compact filters enable SPV confirmation without a full node. Precursor projects (btcmesh, BTCtoolshed bridge, Bitchat) validate individual legs of the design; BMR is the first unified protocol framing."
novelty = 7
btcpc_fit = 7
buildability = 8
hardware_leverage = 9
software_leverage = 8
verification_value = 5
demand_creation = 9
risk_score = 4
handoff_clarity = 9
time_horizon = 3
recommendation = "F"
next_agent = "Design Agent"
orchestrator_summary = "BTCPC's existing LoRa/Nostr/I2P/Tor transport cascade can be extended to relay signed Bitcoin transactions and receive Bitcoin block headers — no new hardware required, no consensus changes. A Bitcoin Mesh Relay (BMR) gateway on each BTCPC node gives the project immediate real-world utility for Bitcoin users in offline/censored regions. Outbound path: tx over LoRa to gateway then Tor to Esplora. Inbound path: block headers via Nostr or Satellite back over LoRa. Design doc produced 2026-05-24 at docs/designs/bitcoin-mesh-relay.md."
status = "sent"
reviewed_by = "artistic-engineer-agent-session-2026-05-22"
date_updated = "2026-05-24"
notes = "goTenna/TxTenna dead ends. Meshtastic is live LoRa substrate. Bitchat (Dorsey) is BLE-only. Reticulum/LXMF could replace ad-hoc chunking. bitcoin-nostr-relay crate is Rust. BMR does NOT touch BTCPC chain consensus. Hardline (no submission without peers) applies to BTCPC entries only, not Bitcoin relay. Regulatory risk flagged — needs Bitcoin Compliance Agent review before production. Design doc at docs/designs/bitcoin-mesh-relay.md created 2026-05-24. novelproposals.md status updated to in-design."

