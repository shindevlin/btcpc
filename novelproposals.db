license = "MIT (Rust crate), CC-BY-4.0 (Python reference)"
last_commit = "2025-12"
activity_level = "active"
tags = "reticulum,rns,transport,mesh,lora,packet-radio,encrypted,rust,p2p,censorship-resistant,low-bandwidth,gateway,x25519,ed25519"
btcpc_area = "P2P protocol / gateway / hardware clients / transport"
summary = "Reticulum is a transport-agnostic encrypted mesh stack (X25519/Ed25519, AES-256-CBC, HMAC-SHA256). Link establishment: 297 bytes, 3 packets. Minimum viable medium: 5 bps. Operates over LoRa (RNode), packet radio, serial, TCP, UDP, I2P. A maintained Rust crate (BeechatNetworkSystemsLtd/Reticulum-rs, MIT, ~150 commits) exists on crates.io, designed for embedded deployments. Could replace BTCPC's ad-hoc LoRa chunking with a unified encrypted transport across all physical media. Transport-only — must never form quorum or influence consensus. Beechat Rust impl feature parity with Python reference unverified; P2P Agent must audit before integration."
novelty = 8
btcpc_fit = 8
buildability = 6
hardware_leverage = 8
software_leverage = 8
verification_value = 5
demand_creation = 5
risk_score = 5
handoff_clarity = 8
time_horizon = 4
recommendation = "H"
next_agent = "P2P Protocol Agent"
orchestrator_summary = "Maintained Rust crate (BeechatNetworkSystemsLtd/Reticulum-rs, MIT) implements Reticulum — transport-agnostic encrypted mesh with X25519/Ed25519, 297-byte link setup, 5 bps minimum. Could unify LoRa/serial/TCP/I2P under one encrypted transport with no chain logic changes. P2P Agent must audit crate for protocol fidelity vs Python reference before integration. Reticulum is transport-only, never quorum-forming."
status = "new"
reviewed_by = "artistic-engineer-agent-session-2026-05-24"
date_updated = "2026-05-24"
notes = "Erethon/reticulum-packet-rs is proof-of-concept only (11 commits, 'ugly hacks', HDLC framing only). BeechatNetworkSystemsLtd/Reticulum-rs is the serious Rust candidate. LXMF not needed — BTCPC uses raw transport layer only. RNode hardware is open-source LoRa transceiver designed for Reticulum, alternative to Meshtastic. Key risk: BeechatNetworkSystemsLtd is a commercial entity, crate not security-audited. MTU minimum 500 bytes — verify BTCPC epoch seal entries fit without fragmentation."

[[proposal]]
id = "c1a5f8d3-2b7e-4c9f-bd34-5e8a1c3f4d9b"
date_found = "2026-05-24"
title = "HF Amateur Radio Data Modes (JS8Call / WSPR beacon)"
source_type = "github+blog+fcc-docs+radio-community"
source_url = "https://js8call.com/"
repo_url = "https://github.com/js8call/js8call"
project_name = "JS8Call — JS8 digital mode for HF messaging"
maintainer = "Jordan Sherer (KN4CRD) + community"
license = "GPL-3.0"
last_commit = "2026-05"
activity_level = "active"
tags = "hf-radio,js8call,winlink,wspr,bpsk31,shortwave,amateur-radio,sdr,censorship-resistant,transport,beacon,low-bandwidth,fcc-part97,epoch-hash"
btcpc_area = "P2P protocol / gateway / future research only"
summary = "JS8Call (GPL-3.0, v3.0.1 active May 2026) provides HF weak-signal FSK messaging with a TCP API on port 2442. Effective throughput ~3-5 bytes/second. A 40-byte BTCPC epoch payload (epoch number + SHA256 hash + node prefix) fits in one message. Integration: BTCPC relay daemon connects to port 2442, no radio firmware work. Hardware: HF transceiver + computer, or SDR transmitter + license. Legal blocker: FCC §97.113(a)(3) prohibits transmissions where operator has pecuniary interest. Cleartext epoch hashes for experimental purposes may be permissible — requires legal review. WSPR (50 bits/2-min) is not a data channel. Winlink prohibited by commercial-use rules. JS8Call is the only viable HF mode for BTCPC."
novelty = 9
btcpc_fit = 5
buildability = 5
hardware_leverage = 6
software_leverage = 4
verification_value = 6
demand_creation = 3
risk_score = 7
handoff_clarity = 8
time_horizon = 7
recommendation = "C"
next_agent = "Bitcoin Compliance Agent"
orchestrator_summary = "JS8Call TCP API (port 2442) enables BTCPC epoch seal hash relay over HF shortwave with no radio firmware work. 40-byte payload fits one message. Legal blocker: FCC §97.113 pecuniary interest prohibition. Bitcoin Compliance Agent must assess whether cleartext epoch hashes transmitted for experimental purposes are permissible before any deployment design. Research backlog until legal clearance obtained."
status = "new"
reviewed_by = "artistic-engineer-agent-session-2026-05-24"
date_updated = "2026-05-24"
notes = "WSPR confirmed dead end: 50 bits per 2-minute slot, payload = callsign+grid+power only, no room for hash data. Winlink dead end: commercial prohibition in Part 97. JS8Call v3.0.1 released May 17 2026 — actively maintained. TCP API confirmed by multiple third-party integrations (js8web, Python lib, Node.js lib, CLI tool). Ham radio license required to transmit (General or Extra class for HF in US). Receive-only (SDR) requires no license. This is last-resort transport only — not primary gossip."

[[proposal]]
id = "d4e9b2c7-3f1a-4d5e-ce56-7f2b4d6e8c1d"
date_found = "2026-05-24"
title = "AM/Shortwave Broadcast Block Header Downlink (Olivia/BPSK31)"
source_type = "blog+github+radio-community"
source_url = "https://swradiogram.net/"
repo_url = "https://github.com/w1hkj/fldigi"
project_name = "Fldigi + Shortwave Radiogram concept"
maintainer = "Dave Freese W1HKJ (Fldigi), Dr. Kim Andrew Elliott (Shortwave Radiogram)"
license = "LGPL-2.1 (Fldigi)"
last_commit = "2025-12"
activity_level = "active"
tags = "am-broadcast,shortwave,olivia,bpsk31,fldigi,rtl-sdr,one-way-downlink,block-header,censorship-resistant,sdr,receive-only,wrmi"
btcpc_area = "gateway / P2P protocol / future research only"
summary = "Olivia 8/250 modem tones transmitted over licensed shortwave broadcast stations can deliver 40-byte BTCPC epoch payloads in ~8 seconds per transmission. Receive stack: $25 RTL-SDR + Fldigi (open source, LGPL-2.1). Proven concept: Shortwave Radiogram on WRMI already broadcasts digital text this way every weekend. One-way downlink only. Gating constraint: transmit access requires licensed broadcaster partnership (WRMI model) or licensed amateur HF transmitter (see HF proposal for regulatory constraints). NRSC-5/HD Radio is a separate proprietary system — not viable without broadcaster and Xperi licensing."
novelty = 8
btcpc_fit = 4
buildability = 3
hardware_leverage = 7
software_leverage = 5
verification_value = 6
demand_creation = 2
risk_score = 5
handoff_clarity = 5
time_horizon = 8
recommendation = "C"
next_agent = "none (research backlog)"
orchestrator_summary = "Shortwave Radiogram proves the stack works: Olivia tones over WRMI, decoded with Fldigi and RTL-SDR. BTCPC 40-byte epoch payload fits in ~8 seconds. Blocker is transmitter access (licensed broadcaster partnership). No agent action needed. Research backlog until BTCPC has credibility to negotiate broadcaster relationship."
status = "new"
reviewed_by = "artistic-engineer-agent-session-2026-05-24"
date_updated = "2026-05-24"
notes = "NRSC-5 (HD Radio) is proprietary OFDM + Xperi codec. Receive-only open source decoder exists (theori/nrsc5) but inject path requires licensed broadcaster + Xperi licensing. Not viable. Olivia is the correct modem for poor propagation — extremely robust, 8/250 submode is the standard. OpenWebRX has BPSK31 demodulator built in — alternative to Fldigi for browser-based receive. Blockstream Satellite (in BMR proposal) is the live production alternative to AM broadcast downlink."

