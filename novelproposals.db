summary = "WiFi HaLow (802.11ah) Pi HATs are purchasable now ($60 ALFA AHPI7292S, AsiaRF, Heltec, Seeed). 1-2 km range, 15-43 Mbps throughput, sub-1 GHz license-exempt band, standard 802.11 networking to Linux. No custom transport protocol — libp2p QUIC runs directly over HaLow interface. Driver (morse_driver) is out-of-tree (not in mainline Linux), requires manual DKMS compilation. Community reports successful builds on kernel 6.6.51 (Bookworm) and Ubuntu 24.04. BTCPC Nebra Pi (192.168.68.75, Debian Trixie, kernel 6.x) is a direct test candidate. Morse Micro MM8108 in mass production Sep 2025, Pi 4 eval kit available on Mouser. HaLow fills the gap between BLE (10m) and LoRa (5km) with full megabit bandwidth and standard WiFi semantics."
novelty = 6
btcpc_fit = 7
buildability = 6
hardware_leverage = 8
software_leverage = 7
verification_value = 4
demand_creation = 5
risk_score = 4
handoff_clarity = 8
time_horizon = 4
recommendation = "B"
next_agent = "Deploy Agent"
orchestrator_summary = "WiFi HaLow Pi HATs are purchasable now. 1-2 km range, 15+ Mbps, standard Linux networking — libp2p QUIC runs over it unchanged. Nebra Pi (192.168.68.75, Debian Trixie) is a direct test candidate. Blocker: out-of-tree driver requires DKMS packaging. Deploy Agent should assess whether morse_driver packages cleanly on Debian Trixie kernel 6.x. If yes, buy one HAT and run a prototype. Upgrade to D (Prototype Later) after DKMS assessment."
status = "new"
reviewed_by = "artistic-engineer-agent-session-2026-05-24"
date_updated = "2026-05-24"
notes = "Driver NOT in mainline Linux as of May 2026. Out-of-tree only. Community builds confirmed on kernel 6.6.51. Debian Trixie ships 6.x — should work but untested by BTCPC. ALFA AHPI7292S available from Rokland (~$60). MM8108 eval kit with Pi 4 available on Mouser. HaLow does NOT replace LoRa for long-range (LoRa wins at 5km+) but fills 300m-2km range with full bandwidth. Verasens sensor nodes: HaLow chips (e.g. Quectel FGH100M-H) could give ESP32-class sensors 1km range at full data rates. Nebra Pi test: compile morse_driver, bring up halow0 interface, run btcpc-node with halow0 as a libp2p transport interface."

[[proposal]]
id = "c4e8f2a1-7b3d-4e9c-a0f5-2d6e1b8c7a4f"
date_found = "2026-05-24"
title = "BTCPC Beacon — Belize AM/SW License Research"
source_type = "regulatory+web"
source_url = "https://puc.bz/telecommunications/; https://belizebroadcastingauthority.org/; https://www.wrmi.net/; https://www.nexus.org/; https://swradiogram.net/"
repo_url = "N/A"
project_name = "BTCPC Shortwave Beacon"
maintainer = "BTCPC"
license = "N/A"
last_commit = "N/A"
activity_level = "active"
tags = "beacon,shortwave,HF,AM,radio,broadcast,license,Belize,SDR,MFSK,epoch,verification,WRMI,NEXUS,offline,censorship-resistance"
btcpc_area = "P2P protocol, hardware clients, verification"
summary = "Research into using Belize broadcast licensing to operate an AM/shortwave beacon broadcasting sealed BTCPC epoch hashes. Finding: Belize license path is not viable near-term — two-regulator system (PUC spectrum + BBA content), ministerial discretion fees, no shortwave infrastructure, no foreign precedent, 6-12 month minimum process. Alternative path via WRMI airtime lease at $1/min is immediately actionable, technically proven (MFSK32 digital mode, RTL-SDR receive, Fldigi decode), and achieves the identical use case for under $10 test cost. Beacon payload: 32-byte epoch hash + height + timestamp (~120 chars), fits under 3 seconds of MFSK32 airtime. Any RTL-SDR dongle ($25) + antenna + Fldigi = chain-tip verification without internet."
novelty = 9
btcpc_fit = 8
buildability = 7
hardware_leverage = 8
software_leverage = 6
verification_value = 9
demand_creation = 6
risk_score = 3
handoff_clarity = 8
time_horizon = 2
recommendation = "E"
next_agent = "Design Agent"
orchestrator_summary = "BTCPC can broadcast sealed epoch hashes as a one-way shortwave beacon via WRMI at $1/min — no Belize license needed. Belize path fully assessed and rejected: two regulators, ministerial discretion fees, zero shortwave infrastructure, no foreign precedent. WRMI path: contact to confirm digital mode (MFSK32 tones) is acceptable, specify beacon payload format (Design Agent), run one test broadcast. Test cost under $10. No chain modifications needed. RTL-SDR ($25) becomes a chain-tip verifier with no internet. Design Agent action: produce beacon frame spec, frequency/schedule recommendation, WRMI contact template."
status = "new"
reviewed_by = "artistic-engineer-agent-session-2026-05-24"
date_updated = "2026-05-24"
notes = "Belize Broadcasting and Television Act (Cap. 227) — fees at ministerial discretion, not codified. PUC SI 76/2024 fee schedule — AM District and AM National categories confirmed in Schedule V, but fee amounts rendered as non-extractable image in PDF (unverified from primary source). WRMI: 14 x 100kW transmitters, 23 antennas, $1/min published block rate, Okeechobee FL, fully FCC licensed. NEXUS-IBA: Milan Italy, 10-300kW, quote-based pricing, audio-first — digital mode content needs explicit negotiation. Shortwave Radiogram uses WRMI today for MFSK32 digital text broadcasts decoded by RTL-SDR + Fldigi — this IS the BTCPC beacon receive stack. Radio Belize ZIK2 (historical shortwave, 5kW Collins) is defunct. No current Belize shortwave infrastructure. Belize IBC formation: $450-1500 USD, 24-48 hours, no residency required — easy but irrelevant to the blocker. Nick Szabo/Elaine Ou HF Bitcoin demo 2017-2018 is prior art confirming feasibility."
