// btcpc_mobile_core.udl — UniFFI interface for BTCPC mobile core library.

namespace btcpc_mobile_core {

    // ── Key derivation ────────────────────────────────────────────────────────

    [Throws=MobileCoreError]
    string derive_posting_pubkey(string mnemonic_words);

    [Throws=MobileCoreError]
    string derive_all_pubkeys(string mnemonic_words);

    // ── Signing ───────────────────────────────────────────────────────────────

    [Throws=MobileCoreError]
    string sign_transfer(
        string mnemonic_words,
        string chain_id,
        string from_account,
        string to_account,
        u64    amount,
        string token,
        u64    nonce
    );

    [Throws=MobileCoreError]
    string sign_stake(
        string mnemonic_words,
        string chain_id,
        string account,
        u64    amount,
        u64    nonce
    );

    [Throws=MobileCoreError]
    string sign_unstake(
        string mnemonic_words,
        string chain_id,
        string account,
        u64    amount,
        u64    nonce
    );

    [Throws=MobileCoreError]
    string sign_account_create(
        string  mnemonic_words,
        string  chain_id,
        string  account,
        string  keys_json,
        string? funded_by
    );

    [Throws=MobileCoreError]
    string sign_node_capability(
        string mnemonic_words,
        string account,
        u64    epoch
    );

    [Throws=MobileCoreError]
    string sign_inference_bid(
        string mnemonic_words,
        string chain_id,
        string bidder,
        string job_id,
        u64    fee,
        string role,
        u64    nonce
    );

    [Throws=MobileCoreError]
    string sign_inference_complete(
        string mnemonic_words,
        string chain_id,
        string worker,
        string job_id,
        string result_hash
    );

    [Throws=MobileCoreError]
    string sign_coverage_report(
        string mnemonic_words,
        string chain_id,
        string reporter,
        f64    lat,
        f64    lon,
        string carrier_mcc_mnc,
        string data_hash
    );

    [Throws=MobileCoreError]
    string sign_sensor_commit(
        string mnemonic_words,
        string chain_id,
        string sensor_id,
        string owner,
        string batch_hash,
        u64    reading_count
    );

    [Throws=MobileCoreError]
    string sign_with_role(
        string mnemonic_words,
        string chain_id,
        u32    role_index,
        string canonical_json
    );

    // ── Node HTTP API ─────────────────────────────────────────────────────────

    [Throws=MobileCoreError]
    string fetch_node_info(string base_url);

    [Throws=MobileCoreError]
    string fetch_balance(string base_url, string account);

    [Throws=MobileCoreError]
    string fetch_account(string base_url, string account);

    [Throws=MobileCoreError]
    string post_transfer(
        string   base_url,
        string   from,
        string   to,
        u64      amount,
        string   token,
        string?  memo,
        string   signed_by,
        u64      nonce,
        string   sig_hex
    );

    [Throws=MobileCoreError]
    string post_stake(
        string base_url,
        string account,
        u64    amount,
        u64    nonce,
        string signed_by,
        string sig_hex
    );

    [Throws=MobileCoreError]
    string post_unstake(
        string base_url,
        string account,
        u64    amount,
        u64    nonce,
        string signed_by,
        string sig_hex
    );

    [Throws=MobileCoreError]
    string post_account_create(
        string  base_url,
        string  account,
        string  keys_json,
        string? funded_by,
        string  sig_hex
    );

    [Throws=MobileCoreError]
    string post_node_capability(
        string  base_url,
        string  account,
        string  sig_hex,
        u64     epoch,
        boolean vision,
        boolean audio,
        boolean code_exec,
        string  tier
    );

    [Throws=MobileCoreError]
    string fetch_inference_jobs(string base_url, string? status_filter);

    [Throws=MobileCoreError]
    string post_coverage_report(
        string  base_url,
        string  reporter,
        f64     lat,
        f64     lon,
        i32?    signal_dbm,
        string  carrier_mcc_mnc,
        string  technology,
        string  data_hash,
        string  sig_hex
    );

    [Throws=MobileCoreError]
    string post_sensor_register(
        string  base_url,
        string  sensor_id,
        string  owner,
        string  sensor_type,
        string? location,
        string  sig_hex
    );

    [Throws=MobileCoreError]
    string post_sensor_commit(
        string  base_url,
        string  sensor_id,
        string  owner,
        string  batch_hash,
        u64     reading_count,
        string  sensor_type,
        f64?    value,
        string  sig_hex
    );

    [Throws=MobileCoreError]
    string post_inference_bid(
        string base_url,
        string job_id,
        string bidder,
        u64    fee,
        string role,
        u64    nonce,
        string sig_hex
    );

    [Throws=MobileCoreError]
    string post_inference_complete(
        string base_url,
        string job_id,
        string worker,
        string result_hash,
        u64    latency_ms,
        string output_text,
        string sig_hex
    );

    // ── BLE frame parsing ─────────────────────────────────────────────────────

    [Throws=MobileCoreError]
    BleFrame parse_ble_frame(bytes raw_frame);

    [Throws=MobileCoreError]
    boolean verify_ble_frame_sig(bytes raw_frame, string flipper_pubkey_hex);
};

[Error]
enum MobileCoreError {
    "InvalidMnemonic",
    "DerivationError",
    "SigningError",
    "NetworkError",
    "ParseError",
    "InvalidFrame",
    "SignatureInvalid",
};

dictionary BleFrame {
    u8    msg_type;
    bytes payload;
};
