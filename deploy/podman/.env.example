# Copy to deploy/podman/.env and fill in before bringing the pod up.
# Consumed by compose.yaml / kube.yaml / the Quadlet units via ${VAR} substitution.

# ── Identity ─────────────────────────────────────────────────────────────
HONE_ACCOUNT=yourname
HONE_NODE_ID=yourname

# 2026-07-04T12:00:00-07:00 — the live HONE genesis. Leave as-is unless you
# are intentionally standing up an isolated/test chain (then also set
# HONE_ISOLATED=true and point HONE_GENESIS_FILE at testnet-genesis.json).
HONE_GENESIS_TIMESTAMP=1783191600000
HONE_CHAIN_ID=hone

# ── Ports ────────────────────────────────────────────────────────────────
HONE_API_PORT=4242
HONE_P2P_PORT=6942

# ── Roles ────────────────────────────────────────────────────────────────
HONE_CLOCK=false
HONE_MINER=false
HONE_WORKER=false

# ── Inference (Candle, in-process — see rust/hone-node/src/inference_engine.rs) ─
# GGUF filename expected in the model cache volume (/data/models). The node
# never auto-downloads; if HONE_MODEL_URL is also set, the entrypoint fetches
# it once and verifies sha256 + the chain's approved-model list before use.
# Leave both unset to run clock-only/relay with no local inference.
HONE_MODEL=
HONE_MODEL_URL=
HONE_MODEL_SHA256=

# cpu (default, deterministic, always works) | cuda | cuda:N — GPU is opt-in
# even in a CUDA-enabled build; see the GPU section in deploy/podman/README.md.
HONE_INFER_DEVICE=cpu

# ── Secrets ──────────────────────────────────────────────────────────────
# If left blank, the entrypoint generates one on first run and persists it
# in the data volume (/data/.secrets_passphrase) so restarts stay decryptable.
HONE_SECRETS_PASSPHRASE=

# ── Image/video (optional, ComfyUI sidecar) ─────────────────────────────
# Only needed if this node opts into image/video generation work. Leave
# unset / profile disabled for text/clock/other roles — it is a large,
# separate Python+CUDA service (see deploy/podman/README.md).
COMFYUI_ENABLED=false
